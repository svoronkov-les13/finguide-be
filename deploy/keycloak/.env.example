# Copy to /opt/finguide-keycloak/.env on the server. Do not commit real values.
KEYCLOAK_PUBLIC_URL=http://66.42.121.18/auth
KEYCLOAK_HTTP_RELATIVE_PATH=/auth
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_BIND_PORT=3094
KEYCLOAK_HOSTNAME_STRICT=false

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-generate-secret

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me-generate-secret

FINGUIDE_REALM=finguide
FINGUIDE_WEB_CLIENT_ID=finguide-web
FINGUIDE_WEB_REDIRECT_URI=http://66.42.121.18/fg/auth/callback
FINGUIDE_WEB_POST_LOGOUT_REDIRECT_URI=http://66.42.121.18/fg/login
